{
  "name": "dorian-dnd",
  "main": "src/worker.js",
  "preview_urls": false,
  "compatibility_date": "2026-10-13",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./src",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "DorianDndApp",
      "database_id": "49ab06a8-18b1-49d0-a2e5-1c324a007f3f"
    }
  ]
}