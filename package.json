{
  "name": "dorian-dnd",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "esbuild src/app.js --bundle --minify --outfile=src/bundle.js --format=esm",
    "db:build": "node scripts/build-db.js",
    "predeploy": "npm test && npm run build",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "assets": {
    "directory": "./src"
  }
}
