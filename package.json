{
  "name": "dorian-dnd",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/app.test.js tests/integration/*.test.js",
    "compile:data": "node scripts/compile-compendiums.js",
    "build:html": "node scripts/build-html.js",
    "build:js": "esbuild src/app.js --bundle --minify --outfile=src/bundle.js --format=esm",
    "build": "npm run build:html && npm run build:js",
    "db:build": "node scripts/build-db.js",
    "predeploy": "npm test && npm run build",
    "deploy": "wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "start": "npm run dev"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "assets": {
    "directory": "./src"
  }
}
