{
  "name": "dorian-dnd",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import ./tests/test-helper.js --test tests/app.test.js tests/unit/*.test.js tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "compile:data": "node scripts/compile-compendiums.js",
    "build:html": "node scripts/build-html.js",
    "build:js": "esbuild src/app.js --bundle --minify --outfile=src/bundle.js --format=esm",
    "build:d1-seed": "node scripts/seed-compendium-d1.js --file-only",
    "build": "npm run build:html && npm run build:js && npm run build:d1-seed",
    "d1:seed": "node scripts/seed-compendium-d1.js",
    "d1:seed:remote": "node scripts/seed-compendium-d1.js --remote",
    "predeploy": "npm test && npm run build",
    "deploy": "wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "assets": {
    "directory": "./src"
  }
}
